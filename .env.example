# ==========================================
# F.R.I.D.A.Y. Configuration Template
# ==========================================

# -----------------
# 1. Server Configuration
# -----------------
HOST=127.0.0.1
PORT=8000
VITE_BACKEND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# -----------------
# 2. LLM Provider Options: "groq" | "ollama" | "mock"
# -----------------
LLM_PROVIDER=groq

# -----------------
# 3. Groq Configuration (Free Tier: https://console.groq.com)
# -----------------
# Paste your Groq API key here (starts with gsk_...)
GROQ_API_KEY=

# Primary Model (Best reasoning & fast)
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Groq Models (Auto-fallback in case of rate-limits or downtime)
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,mixtral-8x7b-32768,gemma2-9b-it

# -----------------
# 4. Local Offline Model (Ollama Fallback)
# -----------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -----------------
# 5. Voice & Audio Settings
# -----------------
WAKE_WORD=FRIDAY
MIC_RECORD_DURATION_SECONDS=7
TTS_VOICE_RATE=190
